{
  "meta": {
    "name": "Claude MD3 Expressive tokens",
    "baseline": "Cyan seed. Re-seed by replacing the color blocks; every component reads roles, never hex.",
    "units": "Sizes are rem (1rem = 16px, never override the root font size). Only hairlines and shadow offsets stay in px."
  },
  "color": {
    "light": {
      "primary": "#006780",
      "on-primary": "#ffffff",
      "primary-container": "#b8eafe",
      "on-primary-container": "#001f29",
      "secondary": "#4a6268",
      "on-secondary": "#ffffff",
      "secondary-container": "#cde7ed",
      "on-secondary-container": "#051f23",
      "tertiary": "#545d62",
      "on-tertiary": "#ffffff",
      "tertiary-container": "#d8e2e7",
      "on-tertiary-container": "#121d22",
      "error": "#ba1a1a",
      "on-error": "#ffffff",
      "error-container": "#ffdad6",
      "on-error-container": "#410002",
      "background": "#f8fafd",
      "on-background": "#191c1e",
      "surface": "#f8fafd",
      "on-surface": "#191c1e",
      "surface-variant": "#dce4e8",
      "on-surface-variant": "#40484c",
      "outline": "#70787d",
      "outline-variant": "#c0c8cd",
      "surface-1": "#ffffff",
      "surface-2": "#eef3f7",
      "surface-3": "#e7edf1",
      "surface-4": "#e1e8ec",
      "surface-5": "#dbe3e8",
      "inverse-surface": "#2e3133",
      "inverse-on-surface": "#eff1f3",
      "inverse-primary": "#4dd0e1",
      "scrim": "#000000"
    },
    "dark": {
      "primary": "#4dd0e1",
      "on-primary": "#00363c",
      "primary-container": "#004f58",
      "on-primary-container": "#97f0ff",
      "secondary": "#80cbc4",
      "on-secondary": "#003733",
      "secondary-container": "#005049",
      "on-secondary-container": "#9ef2ec",
      "tertiary": "#b0bec5",
      "on-tertiary": "#1e272c",
      "tertiary-container": "#2d3d45",
      "on-tertiary-container": "#cfe4ef",
      "error": "#f2b8b5",
      "on-error": "#601410",
      "error-container": "#8c1d18",
      "on-error-container": "#f9dedc",
      "background": "#061018",
      "on-background": "#dee4e7",
      "surface": "#0c1a24",
      "on-surface": "#dee4e7",
      "surface-variant": "#3f4f57",
      "on-surface-variant": "#bfc8ce",
      "outline": "#899297",
      "outline-variant": "#1c2a33",
      "surface-1": "#111f2a",
      "surface-2": "#14242f",
      "surface-3": "#172834",
      "surface-4": "#1a2d3a",
      "surface-5": "#1c3040",
      "inverse-surface": "#dee4e7",
      "inverse-on-surface": "#2b3136",
      "inverse-primary": "#006780",
      "scrim": "#000000"
    },
    "pairs": [
      ["on-primary", "primary", 4.5],
      ["on-primary-container", "primary-container", 4.5],
      ["on-secondary", "secondary", 4.5],
      ["on-secondary-container", "secondary-container", 4.5],
      ["on-tertiary", "tertiary", 4.5],
      ["on-tertiary-container", "tertiary-container", 4.5],
      ["on-error", "error", 4.5],
      ["on-error-container", "error-container", 4.5],
      ["on-background", "background", 4.5],
      ["on-surface", "surface", 4.5],
      ["on-surface", "surface-1", 4.5],
      ["on-surface", "surface-3", 4.5],
      ["on-surface", "surface-5", 4.5],
      ["on-surface-variant", "surface", 4.5],
      ["on-surface-variant", "surface-3", 4.5],
      ["primary", "surface", 4.5],
      ["inverse-on-surface", "inverse-surface", 4.5],
      ["inverse-primary", "inverse-surface", 3],
      ["outline", "surface", 3]
    ]
  },
  "font": {
    "plain": "Roboto, \"Google Sans Text\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "brand": "\"Google Sans Flex\", \"Google Sans\", Roboto, system-ui, sans-serif",
    "note": "No font files are shipped. Brand is for display and headline roles, plain for everything that is read."
  },
  "type": {
    "roles": {
      "display-large":  { "size": 3.5625, "line": 4,    "weight": 400, "tracking": -0.25, "family": "brand" },
      "display-medium": { "size": 2.8125, "line": 3.25, "weight": 400, "tracking": 0,     "family": "brand" },
      "display-small":  { "size": 2.25,   "line": 2.75, "weight": 400, "tracking": 0,     "family": "brand" },
      "headline-large":  { "size": 2,    "line": 2.5,  "weight": 400, "tracking": 0, "family": "brand" },
      "headline-medium": { "size": 1.75, "line": 2.25, "weight": 400, "tracking": 0, "family": "brand" },
      "headline-small":  { "size": 1.5,  "line": 2,    "weight": 400, "tracking": 0, "family": "brand" },
      "title-large":  { "size": 1.375, "line": 1.75, "weight": 400, "tracking": 0,    "family": "brand" },
      "title-medium": { "size": 1,     "line": 1.5,  "weight": 500, "tracking": 0.15, "family": "plain" },
      "title-small":  { "size": 0.875, "line": 1.25, "weight": 500, "tracking": 0.1,  "family": "plain" },
      "body-large":  { "size": 1,     "line": 1.5,  "weight": 400, "tracking": 0.5,  "family": "plain" },
      "body-medium": { "size": 0.875, "line": 1.25, "weight": 400, "tracking": 0.25, "family": "plain" },
      "body-small":  { "size": 0.75,  "line": 1,    "weight": 400, "tracking": 0.4,  "family": "plain" },
      "label-large":  { "size": 0.875,  "line": 1.25, "weight": 500, "tracking": 0.1, "family": "plain" },
      "label-medium": { "size": 0.75,   "line": 1,    "weight": 500, "tracking": 0.5, "family": "plain" },
      "label-small":  { "size": 0.6875, "line": 1,    "weight": 500, "tracking": 0.5, "family": "plain" }
    },
    "emphasizedBoost": 200,
    "emphasizedNote": "Expressive uses heavier emphasized variants for the roles that carry meaning. This kit's convention: regular weight plus 200, capped at 700. Apply with the .md-type-emphasized modifier.",
    "purposes": [
      { "purpose": "hero or splash number, marketing headline", "role": "display-large", "note": "One per screen at most." },
      { "purpose": "page title (h1)", "role": "headline-large", "note": "Use headline-medium on phones." },
      { "purpose": "section title (h2)", "role": "headline-small", "note": "Real h2, contiguous outline." },
      { "purpose": "subsection title (h3)", "role": "title-large" },
      { "purpose": "top app bar title", "role": "title-large", "note": "Medium or large app bars use headline-small and headline-medium." },
      { "purpose": "card title", "role": "title-medium" },
      { "purpose": "dialog headline", "role": "headline-small" },
      { "purpose": "dialog body", "role": "body-medium", "note": "Communication surface: real reading size, never a dense data token." },
      { "purpose": "banner or snackbar text", "role": "body-medium" },
      { "purpose": "onboarding or popup copy", "role": "body-medium", "note": "Body Large when it is the main message." },
      { "purpose": "article paragraph, prose", "role": "body-large" },
      { "purpose": "button label", "role": "label-large" },
      { "purpose": "chip label", "role": "label-large" },
      { "purpose": "tab label", "role": "title-small" },
      { "purpose": "navigation bar label", "role": "label-medium" },
      { "purpose": "list item headline", "role": "body-large" },
      { "purpose": "list item supporting text", "role": "body-medium" },
      { "purpose": "text field input", "role": "body-large" },
      { "purpose": "text field label (floated)", "role": "body-small" },
      { "purpose": "helper text, error text", "role": "body-small" },
      { "purpose": "table header", "role": "title-small" },
      { "purpose": "table cell", "role": "body-medium", "note": "Add tabular-nums for numbers." },
      { "purpose": "caption, footnote, source line", "role": "body-small" },
      { "purpose": "badge, overline, tiny tag", "role": "label-small", "note": "Floor of the scale. Never go below it." },
      { "purpose": "ticker, price grid, dense data cell", "role": "label-medium", "note": "The only place a denser fluid scale is acceptable." }
    ]
  },
  "shape": {
    "scale": {
      "none": 0,
      "xs": 0.25,
      "sm": 0.5,
      "md": 0.75,
      "lg": 1,
      "lg-inc": 1.25,
      "xl": 1.75,
      "xl-inc": 2,
      "2xl": 3
    },
    "full": "100vmax",
    "guidance": [
      "Expressive leans on the large end: cards lg-inc, dialogs xl, buttons and chips full or sm.",
      "Shape morphs on state change (a pressed button goes from full to md, a selected toggle from md to full).",
      "Do not mix more than three radii on one screen."
    ]
  },
  "space": {
    "scale": { "xs": 0.25, "sm": 0.5, "md": 0.75, "lg": 1, "xl": 1.5, "2xl": 2, "3xl": 3 },
    "note": "4dp grid. Component padding comes from the component spec, not from guesses."
  },
  "motion": {
    "duration": {
      "short1": 50, "short2": 100, "short3": 150, "short4": 200,
      "medium1": 250, "medium2": 300, "medium3": 350, "medium4": 400,
      "long1": 450, "long2": 500, "long3": 550, "long4": 600
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "standard-decelerate": "cubic-bezier(0, 0, 0, 1)",
      "standard-accelerate": "cubic-bezier(0.3, 0, 1, 1)",
      "emphasized": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized-decelerate": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "emphasized-accelerate": "cubic-bezier(0.3, 0, 0.8, 0.15)"
    },
    "spring": {
      "fast-spatial":    { "ms": 350, "curve": "cubic-bezier(0.42, 1.67, 0.21, 0.9)" },
      "default-spatial": { "ms": 500, "curve": "cubic-bezier(0.38, 1.21, 0.22, 1)" },
      "slow-spatial":    { "ms": 650, "curve": "cubic-bezier(0.39, 1.29, 0.35, 0.98)" },
      "fast-effects":    { "ms": 150, "curve": "cubic-bezier(0.31, 0.94, 0.34, 1)" },
      "default-effects": { "ms": 200, "curve": "cubic-bezier(0.34, 0.8, 0.34, 1)" },
      "slow-effects":    { "ms": 300, "curve": "cubic-bezier(0.34, 0.88, 0.34, 1)" }
    },
    "springNote": "CSS has no spring. These cubic-bezier curves approximate the Expressive spring tokens: spatial ones overshoot (size, position, shape), effects ones do not (color, opacity). For an exact spring use the Web Animations API with a linear() easing or a motion library.",
    "rules": [
      "Spatial motion (move, resize, reshape) uses the spatial springs, effects (color, opacity) use the effects springs.",
      "Honor prefers-reduced-motion: collapse durations, keep the final state.",
      "Never animate layout properties on long lists. Prefer transform and opacity."
    ]
  },
  "state": {
    "hover": 0.08,
    "focus": 0.1,
    "pressed": 0.1,
    "dragged": 0.16,
    "disabledContent": 0.38,
    "disabledContainer": 0.12,
    "recipe": "background-color: color-mix(in srgb, var(--_c) 8%, var(--_bg)); where --_c is the content color and --_bg the resting container."
  },
  "elevation": {
    "levels": {
      "0": { "shadow": "none", "tonal": "surface" },
      "1": { "shadow": "0 0.0625rem 0.125rem rgba(0, 0, 0, 0.3), 0 0.0625rem 0.1875rem 0.0625rem rgba(0, 0, 0, 0.15)", "tonal": "surface-1" },
      "2": { "shadow": "0 0.0625rem 0.125rem rgba(0, 0, 0, 0.3), 0 0.125rem 0.375rem 0.125rem rgba(0, 0, 0, 0.15)", "tonal": "surface-2" },
      "3": { "shadow": "0 0.25rem 0.5rem 0.1875rem rgba(0, 0, 0, 0.15), 0 0.0625rem 0.1875rem rgba(0, 0, 0, 0.3)", "tonal": "surface-3" },
      "4": { "shadow": "0 0.375rem 0.625rem 0.25rem rgba(0, 0, 0, 0.15), 0 0.125rem 0.1875rem rgba(0, 0, 0, 0.3)", "tonal": "surface-4" },
      "5": { "shadow": "0 0.5rem 0.75rem 0.375rem rgba(0, 0, 0, 0.15), 0 0.125rem 0.25rem rgba(0, 0, 0, 0.3)", "tonal": "surface-5" }
    },
    "guidance": "Expressive prefers tonal surfaces (surface-1 to surface-5) over shadows. Use a shadow only where something floats: FAB, menu, snackbar, dialog."
  },
  "breakpoints": {
    "compact": "under 40rem (phone)",
    "medium": "40rem to 52.5rem (tablet, foldable)",
    "expanded": "52.5rem and up (desktop)",
    "note": "Navigation: bar on compact, rail on medium, drawer on expanded. Content max width about 62rem for reading."
  }
}
